{
  "name": "resuvika-omniball-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Android-first mobile whiteboard by Vikashya Resuvika",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/assets.mjs",
    "sync": "npm run build && cap update android && cap update ios && node scripts/sync-assets.mjs",
    "android": "cap open android",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "check:release": "node scripts/check-release.mjs",
    "notices": "node scripts/notices.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@revenuecat/purchases-capacitor": "14.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "playwright": "1.65.1"
  }
}
